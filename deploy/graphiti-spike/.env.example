# PRISM Graphiti/Neo4j spike - environment template (Phase A)
#
# Copy this file to `.env` next to compose.yaml and fill in the values.
# Every value here is a placeholder: never commit real credentials.
#
# Credentials: PRISM reads these SAME variable names at runtime
# (graphiti.password_env defaults to PRISM_GRAPHITI_PASSWORD; the username
# defaults to Neo4j's standard user `neo4j`, which the compose template
# also uses, unless you set graphiti.username_env and PRISM_GRAPHITI_USERNAME).

# Required. Choose a strong random password for the PRISM-owned container.
PRISM_GRAPHITI_PASSWORD=replace-with-a-strong-random-password

# Optional. Database name for PRISM's graphiti.database and the opt-in tests.
# The Community Edition container serves a SINGLE built-in database named
# `neo4j`; the compose template no longer configures a custom server database.
PRISM_GRAPHITI_DATABASE=neo4j

# Optional. Host ports published by the container (in-container ports stay
# 7474/7687). No guarantee they are free: run check_ports.py first.
PRISM_GRAPHITI_HTTP_PORT=7475
PRISM_GRAPHITI_BOLT_PORT=7688

# Optional overrides used by PRISM's runtime config (config.json graphiti
# section) when connecting to this container:
#   graphiti.uri          = bolt://localhost:7688   (or PRISM_GRAPHITI_URI)
#   graphiti.database     = neo4j
#   graphiti.username_env = PRISM_GRAPHITI_USERNAME (when not the neo4j user)
#   graphiti.group_id     = prism-spike
# The runtime never stores these values in config files.
